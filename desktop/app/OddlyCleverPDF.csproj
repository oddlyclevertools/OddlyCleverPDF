<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop shell: a WinForms window around WebView2, showing the web build in app/.
       .NET Framework 4.8 is part of Windows 10 and 11, so the exe needs no runtime download. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OddlyClever PDF</AssemblyName>
    <RootNamespace>OddlyClever</RootNamespace>
    <AssemblyTitle>OddlyClever PDF</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
